{
  "name": "doc-storage-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "cross-env ELECTRON_IS_DEV=1 electron .",
    "clean": "rimraf build dist release",
    "force-clean": "powershell -ExecutionPolicy Bypass -File force-clean.ps1",
    "kill-electron": "powershell -ExecutionPolicy Bypass -File kill-electron.ps1",
    "prebuild": "npm run kill-electron || echo Skipping kill-electron && npm run force-clean || echo Cleanup failed, continuing anyway",
    "dev": "NODE_ENV=development cross-env ELECTRON_IS_DEV=1 electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run rebuild && electron-builder",
    "build-win": "npm run rebuild && electron-builder --win",
    "build-mac": "npm run prebuild && electron-builder --mac",
    "build-linux": "npm run prebuild && electron-builder --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "document",
    "storage",
    "file",
    "manager",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT",
  "homepage": "./",
  "description": "A modern Electron-based desktop application for storing and managing your documents locally with a beautiful, intuitive interface.",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.2.1",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^6.1.2"
  },
  "build": {
    "appId": "com.yourname.doc-storage-app",
    "productName": "Document Storage App",
    "directories": {
      "output": "build",
      "buildResources": "build"
    },
    "extraMetadata": {
      "main": "main.js"
    },
    "files": [
      "**/*",
      "!test-*",
      "!test-import-folder/**",
      "!*.md",
      "!.git*",
      "!build/**",
      "!dist/**",
      "!release/**",
      "!documents.db",
      "!uploads/**",
      "!force-clean.ps1",
      "!kill-electron.ps1"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}